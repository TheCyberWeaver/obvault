formulas:
  cover_img: '"assets/PDF_Cover/"+file.name.slice(0,file.name.length-4)+".png"'
views:
  - type: cards
    name: PDF Showcase
    filters:
      and:
        - file.ext == "pdf"
        - file.path.startsWith("Math")
    order:
      - file.name
    sort:
      - property: file.name
        direction: ASC
    image: formula.cover_img
    imageAspectRatio: 1.3
    cardSize: 210
